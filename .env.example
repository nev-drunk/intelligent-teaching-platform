# ============================================================
# 智能教学平台 — 环境变量配置模板
# 复制此文件为 .env 或 .env.local 并填入真实值
# 注意：.env / .env.local 已被 .gitignore 忽略，不会提交到 Git
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
DB_PASSWORD=your_db_password

# ── DeepSeek 大模型 ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# ── 百度 OCR ────────────────────────────────────────────────
BAIDU_OCR_APP_ID=your_baidu_app_id
BAIDU_OCR_API_KEY=your_baidu_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key

# ── AI 服务 ─────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5000
DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret
