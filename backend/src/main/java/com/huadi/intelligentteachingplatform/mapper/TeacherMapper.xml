<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.huadi.intelligentteachingplatform.mapper.TeacherMapper">

    <select id="selectByUsername" resultType="com.huadi.intelligentteachingplatform.entity.Teacher">
        SELECT id, username, password, name, avatar, phone, create_time
        FROM tb_teacher
        WHERE username = #{username}
    </select>

</mapper>